# Optional: needed for generated answers and LLM-based verification.
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# Local paths and retrieval settings.
VERIRAG_DATA_DIR=./data/storage
VERIRAG_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
VERIRAG_CHUNK_SIZE=900
VERIRAG_CHUNK_OVERLAP=120
VERIRAG_TOP_K=5
VERIRAG_MAX_UPLOAD_MB=20
VERIRAG_VERIFIER=heuristic

